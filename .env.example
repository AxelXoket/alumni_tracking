# Copy to .env to override the defaults. Every value is optional:
# docker compose and the app fall back to the defaults shown here.

# --- Application ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=Alumni Tracking System
# port published on the host by docker compose
APP_PORT=3000

# --- PostgreSQL ---
# use "localhost" when running the API outside Docker
DB_HOST=localhost
DB_PORT=5432
DB_USER=alumni_app
DB_PASSWORD=alumni_app_pw
DB_NAME=alumni_tracking
# port published on the host by docker compose
DB_EXTERNAL_PORT=5432

# --- Tests and startup ---
# separate database used by `npm test`
TEST_DB_NAME=alumni_tracking_test
# load the idempotent sample data on every start
SEED_ON_START=true
