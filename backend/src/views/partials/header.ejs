<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="brand" href="/home">
        <span class="brand__mark" aria-hidden="true">AT</span>
        <span class="brand__name"><%= appName %></span>
      </a>
      <nav class="nav" aria-label="Main">
        <% const links = [
          { key: 'home', href: '/home', label: 'Home' },
          { key: 'about', href: '/about', label: 'About' },
          { key: 'docs', href: '/api/docs', label: 'API Docs' },
        ]; %>
        <% links.forEach((link) => { %>
          <a href="<%= link.href %>" class="nav__link<%= typeof active !== 'undefined' && active === link.key ? ' is-active' : '' %>"><%= link.label %></a>
        <% }) %>
      </nav>
    </div>
  </header>
  <main class="container page">
