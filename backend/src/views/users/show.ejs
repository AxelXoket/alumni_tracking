<%- include('../partials/header') %>
<% const formatDateTime = (iso) => new Date(iso).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }); %>
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/users">Users</a> / <span><%= user.name %></span></nav>

<section class="card profile">
  <div class="profile__head">
    <span class="avatar avatar--lg" aria-hidden="true"><%= user.name.split(/\s+/).slice(0, 2).map((p) => p[0]).join('').toUpperCase() %></span>
    <div>
      <h1><%= user.name %></h1>
      <span class="badge badge--<%= user.role %>"><%= user.role %></span>
    </div>
  </div>
  <dl class="facts">
    <dt>Email</dt><dd><a href="mailto:<%= user.email %>"><%= user.email %></a></dd>
    <dt>Department</dt><dd><%= user.department || '—' %></dd>
    <dt>Graduation year</dt><dd><%= user.graduationYear || '—' %></dd>
    <dt>Created</dt><dd><%= formatDateTime(user.createdAt) %></dd>
    <dt>Last update</dt><dd><%= formatDateTime(user.updatedAt) %></dd>
    <dt>ID</dt><dd><code><%= user.id %></code></dd>
  </dl>
  <div class="profile__actions">
    <a class="btn" href="/users">Back to list</a>
    <a class="btn" href="/api/users/<%= user.id %>" target="_blank" rel="noopener">View JSON</a>
    <form method="post" action="/users/<%= user.id %>/delete" class="inline-form" data-confirm="Delete <%= user.name %>? This cannot be undone.">
      <button type="submit" class="btn btn--danger">Delete</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
