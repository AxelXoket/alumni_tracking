<%- include('../partials/header') %>
<%
  const label = (value) => value[0].toUpperCase() + value.slice(1);
  const formatDate = (iso) => new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
%>
<section class="page-head">
  <div>
    <p class="eyebrow">Career</p>
    <h1>Applications</h1>
    <p class="muted">Track who applied where, and move each application through the hiring steps.</p>
  </div>
  <div class="page-head__actions">
    <a class="btn" href="/jobs">Browse jobs</a>
    <a class="btn" href="/api/applications" target="_blank" rel="noopener">JSON API</a>
    <button type="button" class="btn btn--primary" data-open="application-form-dialog" data-mode="create">+ New application</button>
  </div>
</section>

<%- include('../partials/flash') %>

<section class="grid grid--4" aria-label="Application statistics">
  <div class="card stat"><span class="stat__value"><%= applications.length %></span><span class="stat__label">Total</span></div>
  <div class="card stat"><span class="stat__value"><%= counts.applied + counts.reviewing %></span><span class="stat__label">Waiting / in review</span></div>
  <div class="card stat"><span class="stat__value"><%= counts.interview %></span><span class="stat__label">Interviews</span></div>
  <div class="card stat"><span class="stat__value"><%= counts.accepted %></span><span class="stat__label">Accepted</span></div>
</section>

<section class="card">
  <div class="toolbar">
    <label class="field field--grow">
      <span class="visually-hidden">Search applications</span>
      <input type="search" class="input" placeholder="Search candidate, job or company…" data-filter="#applications-table" data-key="search">
    </label>
    <label class="field">
      <span class="visually-hidden">Filter by status</span>
      <select class="input" data-filter="#applications-table" data-key="status">
        <option value="">All statuses</option>
        <% statuses.forEach((status) => { %><option value="<%= status %>"><%= label(status) %></option><% }) %>
      </select>
    </label>
  </div>

  <div class="table-wrap">
    <table class="table" id="applications-table">
      <thead>
        <tr><th>Candidate</th><th>Position</th><th>Status</th><th>Applied</th><th><span class="visually-hidden">Actions</span></th></tr>
      </thead>
      <tbody>
        <% applications.forEach((application) => { %>
        <tr data-item data-status="<%= application.status %>"
            data-search="<%= [application.candidate.name, application.candidate.email, application.job.title, application.job.company].join(' ').toLowerCase() %>">
          <td>
            <a href="/users/<%= application.userId %>" class="person__name"><%= application.candidate.name %></a>
            <div class="person__meta"><%= application.candidate.email %></div>
          </td>
          <td>
            <a href="/jobs/<%= application.jobPostingId %>"><%= application.job.title %></a>
            <div class="person__meta"><%= application.job.company %></div>
          </td>
          <td><span class="badge badge--status-<%= application.status %>"><%= application.status %></span></td>
          <td><%= formatDate(application.createdAt) %></td>
          <td>
            <div class="actions">
              <button type="button" class="btn btn--sm" data-open="status-dialog"
                data-record="<%= JSON.stringify({ status: application.status, name: `${application.candidate.name} → ${application.job.title}` }) %>"
                data-endpoint="/api/applications/<%= application.id %>" data-action="/applications/<%= application.id %>/status">Status</button>
              <button type="button" class="btn btn--sm btn--danger-ghost" data-open="delete-dialog"
                data-record="<%= JSON.stringify({ name: `${application.candidate.name}'s application to ${application.job.title}` }) %>"
                data-endpoint="/api/applications/<%= application.id %>" data-action="/applications/<%= application.id %>/delete">Withdraw</button>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="empty" data-empty-for="#applications-table" <%= applications.length ? 'hidden' : '' %>>No applications match your filters.</p>
</section>

<dialog id="application-form-dialog" class="dialog" aria-labelledby="application-form-title">
  <form method="post" action="/applications" data-endpoint="/api/applications" data-method="POST" data-success="applied" class="dialog__body">
    <header class="dialog__head">
      <h2 id="application-form-title">New application</h2>
      <button type="button" class="btn btn--ghost btn--sm" data-close aria-label="Close">&times;</button>
    </header>
    <p class="form-error" role="alert" hidden></p>
    <label class="field"><span>Job *</span>
      <select class="input" name="jobPostingId" required>
        <option value="">Choose a job…</option>
        <% jobs.forEach((job) => { %><option value="<%= job.id %>"><%= job.title %> @ <%= job.company %></option><% }) %>
      </select>
    </label>
    <label class="field"><span>Candidate *</span>
      <select class="input" name="userId" required>
        <option value="">Choose a user…</option>
        <% users.forEach((user) => { %><option value="<%= user.id %>"><%= user.name %> (<%= user.role %>)</option><% }) %>
      </select>
    </label>
    <label class="field"><span>Status</span>
      <select class="input" name="status">
        <% statuses.forEach((status) => { %><option value="<%= status %>"><%= label(status) %></option><% }) %>
      </select>
    </label>
    <label class="field"><span>Cover letter</span>
      <textarea class="input" name="coverLetter" maxlength="2000"></textarea>
    </label>
    <footer class="dialog__foot">
      <button type="button" class="btn" data-close>Cancel</button>
      <button type="submit" class="btn btn--primary">Submit</button>
    </footer>
  </form>
</dialog>

<dialog id="status-dialog" class="dialog dialog--narrow" aria-labelledby="status-title">
  <form method="post" action="#" data-endpoint="#" data-method="PATCH" data-success="updated" class="dialog__body">
    <header class="dialog__head">
      <h2 id="status-title">Change status</h2>
      <button type="button" class="btn btn--ghost btn--sm" data-close aria-label="Close">&times;</button>
    </header>
    <p class="muted" data-field="name"></p>
    <p class="form-error" role="alert" hidden></p>
    <label class="field"><span>Status</span>
      <select class="input" name="status">
        <% statuses.forEach((status) => { %><option value="<%= status %>"><%= label(status) %></option><% }) %>
      </select>
    </label>
    <footer class="dialog__foot">
      <button type="button" class="btn" data-close>Cancel</button>
      <button type="submit" class="btn btn--primary">Save</button>
    </footer>
  </form>
</dialog>

<%- include('../partials/delete-dialog', { entity: 'application' }) %>
<%- include('../partials/footer') %>
